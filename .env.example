# Ollama model to use for structured extraction.
# Must already be pulled: `ollama pull <model>`
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# SQLite database path (created automatically on first run)
DB_PATH=db/pipeline.db

# Directories (relative to project root)
INBOX_DIR=data/inbox
PROCESSED_DIR=data/processed
FAILED_DIR=data/failed

# Minimum confidence (0-1) a field needs to auto-pass validation;
# below this, the record is routed to the review queue instead of the DB.
MIN_FIELD_CONFIDENCE=0.6

# When a record's ONLY problem is low confidence, ask the model to re-check
# the flagged fields against the source text once before routing to review.
# Set to false to always send low-confidence records straight to review.
ENABLE_RECHECK=true
